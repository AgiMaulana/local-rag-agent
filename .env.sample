# LLM Configuration
# Base URL for LLM provider (must follow OpenAI API specs)
LLM_BASE_URL="http://localhost:1234/v1"
# Model name for LLM (e.g., google/gemma-4-e4b, gpt-4o-mini)
LLM_MODEL="google/gemma-4-e4b"
# API key for LLM (use dummy value for local providers like LM Studio)
LLM_API_KEY="lm-studio"

# Embedding Configuration
# Base URL for embedding provider (must follow OpenAI API specs)
EMBEDDING_BASE_URL="http://localhost:1234/v1"
# Model name for embeddings (e.g., text-embedding-nomic-embed-text-v1.5, text-embedding-3-small)
EMBEDDING_MODEL="text-embedding-nomic-embed-text-v1.5"
# API key for embedding provider
OPENAI_API_KEY="lm-studio"

# Folders
KNOWLEDGE_DIR="./knowledge"
DB_DIR="./vector_db"